 */

#ifndef SECRETS_H
#define SECRETS_H

// ID stasiun — harus sama persis dengan yang didaftarkan di halaman /admin
#define STATION_ID "LOC-01"

// APN provider kartu SIM
// Telkomsel: "internet"  |  XL: "internet"  |  Indosat: "indosatgprs"
// Tri: "3gprs"           |  Smartfren: "internet"
#define APN        "internet"
#define GPRS_USER  ""
#define GPRS_PASS  ""

// MQTT Broker
// Development (lokal): IP komputer dalam satu jaringan, port 11883
// Production (VPS)   : IP/domain VPS, port 1883
#define MQTT_SERVER   "GANTI_DENGAN_IP_VPS_ATAU_LOCALHOST"
#define MQTT_PORT     1883
#define MQTT_USER     "revalid"
#define MQTT_PASSWORD "GANTI_DENGAN_MQTT_PASSWORD"

#endif // SECRETS_H
