# ======================================================================
# RE-Valid — Environment Variables
# Salin file ini ke .env dan sesuaikan nilainya
# JANGAN commit file .env ke git
# ======================================================================

# ========== Database ==========
POSTGRES_DB=revalid
POSTGRES_USER=revalid
POSTGRES_PASSWORD=revalidpassword   # Ganti di production!

# Untuk development lokal (backend langsung ke host)
DATABASE_URL=postgresql+asyncpg://revalid:revalidpassword@localhost:5432/revalid
# Untuk Docker (otomatis di-override oleh docker-compose.yml, tidak perlu diubah)
# DATABASE_URL=postgresql+asyncpg://revalid:revalidpassword@db:5432/revalid

# ========== Redis ==========
REDIS_URL=redis://localhost:6379/0
# Docker: redis://redis:6379/0  (otomatis di docker-compose.yml)

# ========== MQTT ==========
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ========== FastAPI ==========
# WAJIB diganti di production — gunakan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ========== CORS ==========
# Development
FRONTEND_URL=http://localhost:3000
# Production: ganti ke domain aktual, contoh: https://revalid.yourdomain.com

# ========== Frontend (Next.js) ==========
# URL backend — untuk development lokal
NEXT_PUBLIC_API_URL=http://localhost:8000
# Docker: http://backend:8000  (di-set otomatis via docker-compose args)
# Production: https://api.yourdomain.com

