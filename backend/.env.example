# Copy this file to .env and fill in real values. Never commit .env to version control.

# Database (asyncpg format)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/revalid

# PostgreSQL (used by docker-compose)
POSTGRES_DB=revalid
POSTGRES_USER=
POSTGRES_PASSWORD=

# Redis
REDIS_URL=redis://localhost:6379/0

# MQTT broker
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# JWT — generate with: openssl rand -hex 32
SECRET_KEY=

# CORS
FRONTEND_URL=http://localhost:3000

# Wind calibration overlay (does not mutate stored measurements)
WIND_CALIBRATION_ENABLED=true
WIND_CALIBRATION_CUTOFF=2026-06-12T14:20:00+07:00
WIND_CALIBRATION_STATIONS=LOC-01,LOC-02,LOC-03
