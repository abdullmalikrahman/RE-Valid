# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Secrets & environment — JANGAN PERNAH DI-COMMIT
.env
.env.local
.env.*.local

# Node.js / Next.js
node_modules/
.next/
out/
npm-debug.log*
*.tsbuildinfo

# Docker volumes (data runtime, bukan config)
pgdata/

# Docker local override — konfigurasi dev lokal, tidak perlu di-commit
docker-compose.override.yml

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Editor
.vscode/settings.json

# MQTT password file — berisi hash password, jangan di-commit
mqtt/config/passwd

# ESP32 secrets — berisi IP server & password MQTT, jangan di-commit
docs/esp32/re_valid_sensor/secrets.h

# Nginx — sertifikat SSL dan ACME challenge (diisi otomatis oleh Certbot)
nginx/certbot/

# Atlas GeoTIFF — file besar, jangan di-commit (download manual, lihat DOWNLOAD_INSTRUCTIONS.txt)
*.tif
*.tiff

# Celery beat — file state runtime, dibuat otomatis saat scheduler berjalan
celerybeat-schedule
celerybeat-schedule.db

# SQLite — database lokal sementara
*.db
*.sqlite3

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
